{
  "name": "proresponse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-env.mts && next build",
    "start": "next start",
    "lint": "eslint",
    "check:env": "tsx scripts/check-env.mts",
    "triage:eval": "node scripts/triage-eval.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > lib/supabase/types.ts",
    "db:validate": "node scripts/validate-sql.ts",
    "db:check": "node scripts/check-seed.ts",
    "triage:coverage": "node scripts/triage-coverage.ts",
    "test:routing": "tsx scripts/test-routing.mts",
    "test:actions": "tsx scripts/test-actions.mts",
    "db:apply": "tsx --env-file=.env.local scripts/apply-migrations.mts",
    "invite": "tsx --env-file=.env.local scripts/invite.mts",
    "db:freshen": "tsx --env-file=.env.local scripts/freshen-demo.mts",
    "db:audit": "tsx --env-file=.env.local scripts/demo-audit.mts",
    "db:demo-users": "tsx --env-file=.env.local scripts/demo-users.mts",
    "db:reset-demo": "npm run db:apply -- --seed && npm run db:demo-users && npm run db:freshen",
    "test:rls": "tsx --env-file=.env.local scripts/test-rls.mts",
    "test:escalation": "tsx scripts/test-escalation.mts",
    "db:keywords": "tsx --env-file=.env.local scripts/seed-keywords.mts",
    "triage:run": "tsx --env-file=.env.local scripts/run-triage.mts",
    "test:matcher": "tsx --env-file=.env.local scripts/test-sql-matcher.mts",
    "test:placards": "tsx --env-file=.env.local scripts/test-placards.mts",
    "test:staff": "tsx scripts/test-staff-admin.mts",
    "test:queue": "tsx scripts/test-my-queue.mts",
    "test:watchdog": "tsx scripts/test-watchdog.mts",
    "test:nonce": "tsx scripts/test-nonce.mts",
    "test:alerts": "tsx scripts/test-alerts.mts",
    "test:grants": "tsx scripts/test-grants.mts",
    "test:realtime": "tsx scripts/test-realtime.mts",
    "test:accounts": "tsx scripts/test-accounts.mts",
    "test:conformance": "tsx scripts/test-routing-conformance.mts",
    "test:reconciliation": "tsx scripts/test-reconciliation.mts",
    "test:escalation-sim": "tsx scripts/test-escalation-sim.mts",
    "test:e2e": "tsx scripts/test-e2e-journey.mts",
    "test:authz": "tsx scripts/test-authz.mts",
    "verify:offline": "npm run test:conformance && npm run test:routing && npm run test:actions && npm run test:grants && npm run test:alerts && npm run test:watchdog && npm run test:nonce && npm run test:queue && npm run test:staff && npm run test:escalation && npm run test:escalation-sim && npm run test:placard-origin",
    "verify:live": "npm run test:rls && npm run test:matcher && npm run test:placards && npm run test:accounts && npm run test:authz && npm run test:reconciliation && npm run test:e2e && npm run test:realtime",
    "verify": "npm run verify:offline && npm run verify:live",
    "test:placard-origin": "tsx scripts/test-placard-origin.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "shadcn": "^4.20.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
