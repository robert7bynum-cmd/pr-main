# Supabase (proresponse-dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, never NEXT_PUBLIC_

# Triage
ANTHROPIC_API_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# SMS — blocked on Twilio A2P 10DLC registration, not used for the 11 Sep demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret guarding /api/triage/run (service-role privileges)
TRIAGE_WORKER_SECRET=

# Direct Postgres connection for migrations (Connect -> Session pooler URI)
SUPABASE_DB_URL=

# Enables one-click demo personas on /login. Never set for a real club.
DEMO_SIGNIN=
